    "except ImportError:\n",
    "    print(\"PyTorch not yet installed in current Python environment.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Run Depth-Sampled MLP Activation Caching\n",
    "\n",
    "We sample **Layers 16, 24, and 32** to profile early-middle, middle, and late-middle MLP features.\n",
    "If running in an environment without GPU VRAM for the 12B model, `--dry-run` simulates the pipeline using deterministic synthetic activations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from scripts.cache_activations import load_corpus, run_activation_caching\n",
    "\n",
    "corpus_path = Path(project_root) / \"corpus\" / \"gemma_ast_corpus.jsonl\"\n",
    "summary_path = Path(project_root) / \"corpus\" / \"activation_summary.json\"\n",
    "\n",
    "records = load_corpus(corpus_path)\n",
    "\n",
    "# Run caching pipeline (auto-detects GPU or falls back to validation simulator)\n",
    "summary = run_activation_caching(\n",
    "    corpus_records=records,\n",
    "    model_name=\"google/gemma-4-12B-it\",\n",
    "    layers=[16, 24, 32],\n",
    "    device=\"auto\",\n",
    "    dry_run=not ('torch' in sys.modules and getattr(sys.modules.get('torch'), 'cuda', None) and sys.modules['torch'].cuda.is_available()),\n",
    "    output_path=summary_path,\n",
    ")\n",
    "\n",
    "print(f\"✅ Activation caching complete. Summary saved to: {summary_path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Ingest and Format Activation Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import pandas as pd\n",
    "\n",
    "with open(summary_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "rows = []\n",
    "for layer_key, layer_val in data[\"layers\"].items():\n",
    "    layer_idx = layer_val[\"layer_index\"]\n",
    "    for cat_name, cat_val in layer_val[\"categories\"].items():\n",
    "        top_n = cat_val[\"top_candidate_neurons\"][0]\n",
    "        rows.append({\n",
    "            \"layer\": f\"Layer {layer_idx}\",\n",
    "            \"category\": cat_name,\n",
    "            \"target_keyword\": cat_val[\"target_keyword\"],\n",
    "            \"mean_delta\": cat_val[\"mean_overall_delta\"],\n",
    "            \"delta_variance\": cat_val[\"delta_variance\"],\n",
    "            \"peak_neuron_idx\": top_n[\"neuron_idx\"],\n",
    "            \"peak_delta\": top_n[\"delta\"],\n",
    "            \"target_act\": top_n[\"mean_target_act\"],\n",
    "            \"control_act\": top_n[\"mean_control_act\"],\n",
    "            \"q50_median\": cat_val[\"quantiles\"][\"q50_median\"],\n",
    "            \"q95\": cat_val[\"quantiles\"][\"q95\"],\n",
    "            \"q100_max\": cat_val[\"quantiles\"][\"q100_max\"],\n",
    "        })\n",
    "\n",
    "df_metrics = pd.DataFrame(rows)\n",
    "display(df_metrics[[\"layer\", \"category\", \"peak_neuron_idx\", \"peak_delta\", \"target_act\", \"control_act\", \"delta_variance\"]])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Visualizing Monosemantic Activation Discrepancies\n",
    "\n",
    "Below we chart the activation distributions comparing Target constructs against Near-Miss controls across the sampled middle layers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Set high-contrast publication styling\n",
    "plt.style.use(\"seaborn-v0_8-whitegrid\" if \"seaborn-v0_8-whitegrid\" in plt.style.available else \"default\")\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5), sharey=True)\n",
    "\n",
    "layers = [\"Layer 16\", \"Layer 24\", \"Layer 32\"]\n",
    "categories = df_metrics[\"category\"].unique()\n",
    "palette = [\"#1f77b4\", \"#ff7f0e\", \"#2ca02c\", \"#d62728\", \"#9467bd\"]\n",
    "\n",
    "for idx, layer in enumerate(layers):\n",
    "    ax = axes[idx]\n",
    "    sub_df = df_metrics[df_metrics[\"layer\"] == layer]\n",
    "    \n",
    "    x = np.arange(len(sub_df))\n",
    "    width = 0.35\n",
    "    \n",
    "    ax.bar(x - width/2, sub_df[\"target_act\"], width, label=\"Target Construct\", color=\"#10b981\", alpha=0.9)\n",
    "    ax.bar(x + width/2, sub_df[\"control_act\"], width, label=\"Near-Miss Control\", color=\"#ef4444\", alpha=0.9)\n",
    "    \n",
    "    ax.set_title(f\"{layer} Peak Neuron Activation\", fontsize=13, fontweight=\"bold\")\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels(sub_df[\"category\"], rotation=35, ha=\"right\", fontsize=10)\n",
    "    ax.set_xlabel(\"AST Category\", fontsize=11)\n",
    "    if idx == 0:\n",
    "        ax.set_ylabel(\"Mean Neuron Activation (hook_post)\", fontsize=11)\n",
    "        ax.legend(frameon=True)\n",
    "    ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "plt.suptitle(\"Contrastive Activation Separation across Middle MLP Layers (google/gemma-4-12B-it)\", fontsize=15, fontweight=\"bold\", y=1.03)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Differential Delta Heatmap ($\Delta A = A_{\\text{target}} - A_{\\text{control}}$)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pivot_deltas = df_metrics.pivot(index=\"category\", columns=\"layer\", values=\"peak_delta\")\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "im = plt.imshow(pivot_deltas, cmap=\"viridis\", aspect=\"auto\")\n",
    "plt.colorbar(im, label=\"Peak Activation Delta (Target - Control)\")\n",
    "\n",
    "plt.xticks(range(len(pivot_deltas.columns)), pivot_deltas.columns, fontsize=11)\n",
    "plt.yticks(range(len(pivot_deltas.index)), pivot_deltas.index, fontsize=11)\n",
    "plt.title(\"Layer-wise Peak Monosemantic Separation by AST Category\", fontsize=13, fontweight=\"bold\", pad=12)\n",
    "\n",
    "# Annotate cell values\n",
    "for i in range(len(pivot_deltas.index)):\n",
    "    for j in range(len(pivot_deltas.columns)):\n",
    "        val = pivot_deltas.iloc[i, j]\n",
    "        plt.text(j, i, f\"{val:+.2f}\", ha=\"center\", va=\"center\", color=\"white\" if val > 2.8 else \"black\", fontweight=\"bold\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Monosemantic Candidate Summary Table\n",
    "\n",
    "Top individual neurons identified per category displaying the highest selective firing on target syntax:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "candidates = df_metrics.sort_values(by=\"peak_delta\", ascending=False)[\n",
    "    [\"layer\", \"category\", \"target_keyword\", \"peak_neuron_idx\", \"target_act\", \"control_act\", \"peak_delta\"]\n",
    "].reset_index(drop=True)\n",
    "\n",
    "candidates.columns = [\n",
    "    \"Layer\", \"AST Category\", \"Keyword\", \"Candidate Neuron ID\", \"Target Act\", \"Control Act\", \"Delta (Target - Control)\"\n",
    "]\n",
    "display(candidates)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Next Steps: Phase 3 (Causal Neuron Intervention & Ablation)\n",
    "\n",
    "With candidate monosemantic neurons localized across middle layers:\n",
    "1. **Zero-Ablation**: Clamping candidate neuron activations to 0.0 during code synthesis to test whether AST syntax generation specifically collapses.\n",
    "2. **Steering Vectors & Clamping**: Artificially amplifying candidate activations to measure whether Gemma forces specific syntax structures (e.g. inserting `try/except` blocks).\n",
    "3. **Paper Track Manuscript**: Formalizing layer-depth selectivity curves for the Gemma 4 paper submission."
   ]
  }
 ],
